---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><HeaderLink href="/">{SITE_TITLE}</HeaderLink></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: transparent;
	}
	h2 {
		margin: 0;
		font-size: clamp(2rem, 5vw, 3.2rem);
		font-family: Verdana, sans-serif;
		letter-spacing: -0.04em;
		font-weight: 700;
		line-height: 1.1;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: rgb(var(--black));
	}
	nav {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.15rem;
		max-width: 760px;
		margin: 0 auto;
		padding: 2rem 0 0.5rem;
	}
	.internal-links {
		display: flex;
		gap: 0.9rem;
		flex-wrap: wrap;
	}
	nav a {
		padding: 0;
		color: #3273dc;
		border-bottom: 0;
		font-size: 0.9rem;
		letter-spacing: 0;
		text-transform: none;
		font-weight: 400;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: underline;
		border-bottom-color: transparent;
		color: #3273dc;
		font-weight: 700;
	}
	nav a:hover {
		color: #2457a7;
		text-decoration: underline;
	}
	@media (max-width: 720px) {
		nav {
			padding-top: 1.5rem;
		}
		.internal-links {
			gap: 0.65rem;
		}
		nav a {
			font-size: 0.82rem;
		}
	}
</style>