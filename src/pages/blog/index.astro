---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 760px;
				max-width: calc(100% - 2em);
			}
			section {
				padding-top: 0.05rem;
			}
			.search-wrap {
				margin: 0 0 1.4rem;
			}
			#blog-search {
				width: 100%;
				box-sizing: border-box;
				padding: 0.8rem 0.9rem;
				border: 1px solid rgba(34, 34, 34, 0.18);
				border-radius: 4px;
				font: inherit;
				font-size: 0.95rem;
				background: #fff;
				color: rgb(var(--black));
			}
			#blog-search:focus {
				outline: 2px solid rgba(50, 115, 220, 0.18);
				outline-offset: 1px;
			}
			ul {
				list-style: disc;
				margin: 0;
				padding-left: 1.35rem;
			}
			ul li {
				width: 100%;
				margin: 0.55rem 0;
			}
			ul li a {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1rem;
				padding: 0.18rem 0;
				color: rgb(var(--black));
				text-decoration: none;
				width: 100%;
			}
			ul li a:hover .title,
			ul li a:hover .date {
				color: var(--accent-dark);
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				font-size: 1.08rem;
				font-weight: 400;
				font-family: Verdana, sans-serif;
				letter-spacing: -0.02em;
				line-height: 1.5;
				min-width: 0;
				word-break: break-word;
			}
			.date {
				color: #3273dc;
				font-size: 0.82rem;
				white-space: nowrap;
				width: 7.2rem;
				flex-shrink: 0;
			}
			@media (max-width: 720px) {
				main {
					width: 100%;
				}
				ul li a {
					display: block;
				}
				.date {
					display: inline-block;
					margin-bottom: 0.15rem;
					width: auto;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<div class="search-wrap">
					<input id="blog-search" type="search" placeholder="Search posts..." aria-label="Search posts" />
				</div>
				<ul>
					{
						posts.map((post) => (
							<li class="post-item" data-search={post.data.title.toLowerCase()}>
								<a href={`${baseUrl}blog/${post.id}/`}>
									<span class="date">
										<FormattedDate date={post.data.pubDate} />
									</span>
									<span class="title">{post.data.title}</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
		<script>
			const searchInput = document.getElementById('blog-search') as HTMLInputElement | null;
			const postItems = Array.from(document.querySelectorAll('.post-item')) as HTMLElement[];
			if (searchInput) {
				searchInput.addEventListener('input', (event) => {
					const target = event.target as HTMLInputElement | null;
					const query = (target?.value || '').toLowerCase().trim();
					postItems.forEach((item) => {
						const haystack = (item.getAttribute('data-search') || '').toLowerCase();
						const visible = !query || haystack.includes(query);
						item.style.display = visible ? '' : 'none';
					});
				});
			}
		</script>
	</body>
</html>
